/*
 * Example local override config for SORAT.
 *
 * Copy this file to .sorat/user.config (gitignored), or run:
 *   python3 bin/sorat_setup.py
 */

params {
    // Preferred generic defaults for SAX auto input generation.
    sax_data_root         = '/path/to/sax_data_root'
    sax_data_split        = 'testing'

    // Legacy aliases retained for compatibility.
    acdc_dir              = '/path/to/sax_data_root'
    acdc_dataset          = 'testing'

    // Required when using -profile slurm.
    slurm_account         = 'your-allocation'

    // Optional runtime/cache overrides.
    singularity_cache_dir = '/path/to/.singularity_cache'
    preprocess_cache_dir  = '/path/to/sorat/.cache/preprocess'
    outdir                = '/path/to/sorat/results'

    // Optional explicit samplesheet overrides.
    default_inputs {
        sax               = null
        atrial            = null

        // Legacy aliases retained for compatibility.
        acdc              = null
        mbas              = null
    }

    // Frame selection mode (when info_cfg is absent):
    //   auto  — use ED/ES if info_cfg present, else all frames
    //   ed_es — always force 2 frames (ED=frame 0, ES=last frame)
    //   all   — always segment all temporal frames
    frames_mode         = 'auto'
    // Maximum frames when in all-frames mode (null = unlimited, e.g. 10 = subsample)
    max_frames          = null

    // Optional atrial default root for automatic input generation.
    atrial_nnunet {
        dataset_root      = null

        // Legacy alias retained for compatibility.
        mbas_root         = null
    }

    // Optional bind strings for local/slurm profiles.
    singularity_local_binds = '/path/to/SORAT/bin:/app/bin,/path/to/SORAT/nnformer:/app/nnformer'
    singularity_slurm_binds = '/arc:/arc,/scratch:/scratch,/path/to/SORAT/bin:/app/bin,/path/to/SORAT/nnformer:/app/nnformer'
}
